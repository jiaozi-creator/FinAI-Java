# FinAI 环境变量配置

# LLM 提供商选择 (aliyun/claude/openai)
LLM_PROVIDER=aliyun

# 阿里云百炼平台配置
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 非竞赛开发可选；COMPETITION_MODE=false 时方可使用
# ANTHROPIC_API_KEY=

# OpenAI API（可选）
# OPENAI_API_KEY=

COMPETITION_MODE=true
DEV_MOCK_LLM=false
DEV_DEMO_ENABLED=false
H2_CONSOLE_ENABLED=false
LLM_MODEL=qwen3.7-flash

# 数据库配置（使用 H2 内存数据库）
SPRING_DATASOURCE_URL=jdbc:h2:mem:finai
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# 应用配置
SERVER_PORT=8080

# FinAI 环境变量配置

# LLM 提供商选择 (aliyun/claude/openai)
LLM_PROVIDER=aliyun

# 阿里云百炼平台配置
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Anthropic Claude 官方 API（可选）
ANTHROPIC_API_KEY=

# OpenAI API（可选）
OPENAI_API_KEY=

# 数据库配置（使用 H2 内存数据库）
SPRING_DATASOURCE_URL=jdbc:h2:mem:finai
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# 应用配置
SERVER_PORT=8080

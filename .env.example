# LLM Provider Configuration
LLM_PROVIDER=aliyun
COMPETITION_MODE=true
ALIYUN_API_KEY=
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Offline demo only: LLM_PROVIDER=mock and DEV_MOCK_LLM=true
# In non-competition development only: COMPETITION_MODE=false

# Anthropic Claude API
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE=https://api.anthropic.com

# OpenAI GPT API
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# Model Configuration
LLM_MODEL=qwen3.7-flash
# Aliyun text chat examples: qwen3.7-flash, qwen3.8-max, qwen-plus
# Claude options (non-competition only): claude-3-opus-20240229, claude-3-sonnet-20240229
# OpenAI options (non-competition only): gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60000

# Database Configuration
DB_URL=jdbc:h2:./data/finai;MODE=MySQL;DATABASE_TO_LOWER=TRUE
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver

# Application Configuration
SERVER_PORT=8080
SERVER_HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/finai.log
AUDIT_LOG_PATH=./logs/audit.log

# File Upload Configuration
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=100MB
UPLOAD_DIR=./data/uploads

# Data Directory Configuration
DATA_RAW_DIR=./data/raw
DATA_STRUCTURED_DIR=./data/structured
DATA_MANIFESTS_DIR=./data/manifests
OUTPUT_REPORTS_DIR=./outputs/reports
OUTPUT_EVIDENCE_DIR=./outputs/evidence

# Config Files
CONFIG_COMPANIES_FILE=./config/companies.yaml
CONFIG_FIELD_DICT_FILE=./config/field_dict.yaml
CONFIG_FORMULAS_FILE=./config/formulas.yaml
CONFIG_RULES_FILE=./config/rules.yaml

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_ENABLE_DEGRADATION=true
AGENT_ENABLE_AUDIT=true

# Tool Configuration
TOOL_CALC_PRECISION=10
TOOL_CALC_ROUNDING_MODE=HALF_UP

# PDF Parser Configuration
PDF_PARSER_ENGINE=pdfbox
# Options: pdfbox, itext

# OCR Configuration (Optional)
OCR_ENABLED=false
OCR_LANGUAGE=chi_sim

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600

# Feature Flags
FEATURE_VALUATION_ENABLED=true
FEATURE_ANOMALY_DETECTION_ENABLED=true
FEATURE_EVIDENCE_TRACKING_ENABLED=true
FEATURE_MCP_ENABLED=false

# Development Mode
DEV_MODE=true
DEV_MOCK_LLM=false
DEV_DEMO_ENABLED=false
H2_CONSOLE_ENABLED=false
DEV_SKIP_AUTH=true

# Performance Monitoring
MONITORING_ENABLED=true
METRICS_EXPORT_INTERVAL=60

# Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=86400000

# Email Notification (Optional)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@finai.com
